# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Base64-encoded 32-byte key for encrypting per-mailbox AI API keys.
# Generate: openssl rand -base64 32
# Production: npx wrangler secret put AI_CONFIG_ENCRYPTION_KEY
# Keep this key stable; changing it requires re-entering saved API keys.
AI_CONFIG_ENCRYPTION_KEY=
